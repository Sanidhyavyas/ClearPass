NODE_ENV=development
PORT=5000
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRY=1h
BCRYPT_ROUNDS=10
CLIENT_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────
# Full connection string (preferred for Postgres):
DATABASE_URL=postgresql://user:password@localhost:5432/clearpass_db
# Or individual fields (legacy MySQL-style keys kept for backwards-compat):
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=clearpass
DB_PORT=3306

# ── Clearance Engine Rules ────────────────────────────────────────────────
MIN_ATTENDANCE_PERCENT=75
BLOCK_ON_PENDING_FEES=true
BLOCK_ON_LIBRARY_DUES=true
AUTO_APPROVE_ON_PASS=false

# ── Logging ──────────────────────────────────────────────────────────────
# Levels: error | warn | info | debug
LOG_LEVEL=info

# Timestamp format tokens: YYYY MM DD HH mm ss
LOG_TIME_FORMAT=YYYY-MM-DD HH:mm:ss

# Environment (production=JSON logs, development=pretty logs)
NODE_ENV=development
PORT=5000
JWT_SECRET=replace_with_a_long_random_secret
CLIENT_URL=http://localhost:3000

# SMTP — Gmail example (use App Password if 2FA is on)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Mailtrap example (for testing)
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=mailtrap_username
# SMTP_PASS=mailtrap_password
