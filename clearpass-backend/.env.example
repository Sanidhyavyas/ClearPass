NODE_ENV=development
PORT=5000
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRY=1h
BCRYPT_ROUNDS=10
CLIENT_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────
# Full connection string (preferred for Postgres):
DATABASE_URL=postgresql://user:password@localhost:5432/clearpass_db
# Or individual fields (legacy MySQL-style keys kept for backwards-compat):
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=clearpass
DB_PORT=3306

# ── External Service Mock Control ─────────────────────────────────────────
# Set to "true" to force mock data even when internal DB columns exist.
USE_MOCK_LIBRARY=false
USE_MOCK_ATTENDANCE=false

# ── External Service API URLs (optional; falls back to internal DB / mock) ──
# LIBRARY_API_URL=https://library.example.com/api
# LIBRARY_API_KEY=your_library_api_key
# ATTENDANCE_API_URL=https://attendance.example.com/api
# ATTENDANCE_API_KEY=your_attendance_api_key
# FEE_API_URL=https://fees.example.com/api
# FEE_API_KEY=your_fee_api_key

# ── Twilio SMS (optional) ──────────────────────────────────────────────────
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_FROM=+15005550006

# ── Clearance Engine Rules ────────────────────────────────────────────────
MIN_ATTENDANCE_PERCENT=75
BLOCK_ON_PENDING_FEES=true
BLOCK_ON_LIBRARY_DUES=true
AUTO_APPROVE_ON_PASS=false

# ── Logging ──────────────────────────────────────────────────────────────
# Levels: error | warn | info | debug
LOG_LEVEL=info

# Timestamp format tokens: YYYY MM DD HH mm ss
LOG_TIME_FORMAT=YYYY-MM-DD HH:mm:ss

# SMTP — Gmail example (use App Password if 2FA is on)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Mailtrap example (for testing)
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=mailtrap_username
# SMTP_PASS=mailtrap_password
