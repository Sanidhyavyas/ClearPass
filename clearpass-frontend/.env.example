# ClearPass Frontend — Environment Variables
# Copy this file to .env.local and fill in your values.
# Only variables prefixed with REACT_APP_ are exposed to the browser bundle.
# Never commit your real .env.local to version control.

# ── API ──────────────────────────────────────────────────────────────────
# Local development:
# REACT_APP_API_URL=http://localhost:5000
REACT_APP_API_URL=https://clearpass-backend.onrender.com

# ── Logging ──────────────────────────────────────────────────────────────
# Levels: error | warn | info | debug
# Production default is "warn" (only warnings + errors logged & shipped)
REACT_APP_LOG_LEVEL=warn

# Must match backend LOG_TIME_FORMAT so timestamps are comparable
REACT_APP_LOG_TIME_FORMAT=YYYY-MM-DD HH:mm:ss

# ── Feature Flags ─────────────────────────────────────────────────────────
# Set to true to enable the QR-code clearance certificate feature
# REACT_APP_ENABLE_QR_CERT=false
